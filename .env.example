# Generate with: openssl rand -hex 32
# Signs session JWTs AND encrypts data at rest (OAuth tokens, stored app
# credentials). The auto-generated fallback lives inside the container, so a
# recreated container gets a new key: everyone is logged out and anything
# encrypted with the old key stops decrypting. Set it once and keep it.
WEBUI_SECRET_KEY=

# Client API access (off by default in Open WebUI)
ENABLE_API_KEYS=true

# New sign-ups wait for admin approval ("pending"), or auto-activate ("user")
DEFAULT_USER_ROLE=pending

# Optional overrides (defaults are in docker-compose.yml)
# OPEN_WEBUI_VERSION=v0.13.3
# OPEN_WEBUI_BIND=127.0.0.1
# OLLAMA_BASE_URL=http://ollama:11434
