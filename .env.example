# Generate with: openssl rand -hex 32
# Signs session JWTs AND encrypts data at rest. Without a fixed key, every
# recreated container logs everyone out (and breaks MCP OAuth tokens / MFA).
WEBUI_SECRET_KEY=

# Client API access (off by default in Open WebUI)
ENABLE_API_KEYS=true

# New sign-ups wait for admin approval ("pending"), or auto-activate ("user")
DEFAULT_USER_ROLE=pending
